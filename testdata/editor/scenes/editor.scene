{
  "name": "editor",
  "background_color": "#15171e",
  "objects": [
    {
      "name": "ui_root",
      "layer": 2,
      "components": [
        { "kind": "@UIManager", "name": "ui", "args": { "auto_raise": true } }
      ]
    },
    {
      "name": "layout",
      "layer": 4,
      "components": [
        { "kind": "EditorLayoutComponent", "name": "layout" }
      ]
    },
    {
      "name": "header",
      "ui": true,
      "layer": 2,
      "components": [
        { "kind": "@Panel", "name": "bar", "args": { "color": "#1d2130", "width": 960, "height": 24 } },
        { "kind": "@Label", "name": "title", "args": { "text": "IMGE EDITOR", "size": 12, "color": "#ffffff", "offset": { "x": 12, "y": 5 } } },
        { "kind": "@Label", "name": "hint", "args": { "text": "middle-drag / Space+drag: pan    wheel: zoom    Ctrl+Z/Y: undo/redo", "size": 6, "color": "#8a8a9a", "offset": { "x": 170, "y": 8 } } }
      ]
    },
    {
      "name": "toolbar",
      "ui": true,
      "layer": 2,
      "transform": { "position": { "x": 0, "y": 24 } },
      "components": [
        { "kind": "ToolbarComponent", "name": "toolbar", "args": { "width": 960, "height": 22 } }
      ]
    },
    {
      "name": "scene_tree",
      "ui": true,
      "layer": 1,
      "transform": { "position": { "x": 0, "y": 46 } },
      "components": [
        { "kind": "SceneTreeComponent", "name": "tree", "args": { "width": 180, "height": 494 } }
      ]
    },
    {
      "name": "viewport",
      "ui": true,
      "layer": 0,
      "transform": { "position": { "x": 180, "y": 46 } },
      "components": [
        { "kind": "ViewportComponent", "name": "viewport", "args": { "scene": "main", "draw_debug": true, "width": 600, "height": 404 } }
      ]
    },
    {
      "name": "inspector",
      "ui": true,
      "layer": 3,
      "transform": { "position": { "x": 780, "y": 46 } },
      "components": [
        { "kind": "InspectorComponent", "name": "inspector", "args": { "width": 180, "height": 494 } }
      ]
    },
    {
      "name": "console",
      "ui": true,
      "layer": 3,
      "transform": { "position": { "x": 180, "y": 450 } },
      "components": [
        { "kind": "ConsoleComponent", "name": "console", "args": { "width": 600, "height": 90 } }
      ]
    }
  ]
}
