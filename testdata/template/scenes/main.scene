{
  "name": "main",
  "background_color": "#8fd0ff",
  "objects": [
    {
      "name": "game",
      "depth": 100,
      "tags": ["game"],
      "components": [
        { "kind": "components/game.go", "name": "game", "args": { "total": 5 } }
      ]
    },

    {
      "name": "ground",
      "depth": 0,
      "tags": ["platform"],
      "transform": { "position": { "x": 0, "y": 536 } },
      "components": [
        { "kind": "@Sprite", "name": "sprite", "args": { "texture": "platform.png", "width": 800, "height": 64 } },
        { "kind": "@Collider", "name": "hitbox", "args": { "width": 800, "height": 64, "mode": "solid" } }
      ]
    },

    {
      "name": "wallL",
      "depth": 0,
      "tags": ["wall"],
      "transform": { "position": { "x": 0, "y": 0 } },
      "components": [
        { "kind": "@Sprite", "name": "sprite", "args": { "texture": "platform.png", "width": 16, "height": 600 } },
        { "kind": "@Collider", "name": "hitbox", "args": { "width": 16, "height": 600, "mode": "solid" } }
      ]
    },

    {
      "name": "wallR",
      "depth": 0,
      "tags": ["wall"],
      "transform": { "position": { "x": 784, "y": 0 } },
      "components": [
        { "kind": "@Sprite", "name": "sprite", "args": { "texture": "platform.png", "width": 16, "height": 600 } },
        { "kind": "@Collider", "name": "hitbox", "args": { "width": 16, "height": 600, "mode": "solid" } }
      ]
    },

    {
      "name": "p1",
      "depth": 0,
      "tags": ["platform"],
      "transform": { "position": { "x": 140, "y": 440 } },
      "components": [
        { "kind": "@Sprite", "name": "sprite", "args": { "texture": "platform.png", "width": 176, "height": 24 } },
        { "kind": "@Collider", "name": "hitbox", "args": { "width": 176, "height": 24, "mode": "solid" } }
      ]
    },

    {
      "name": "p2",
      "depth": 0,
      "tags": ["platform"],
      "transform": { "position": { "x": 380, "y": 360 } },
      "components": [
        { "kind": "@Sprite", "name": "sprite", "args": { "texture": "platform.png", "width": 144, "height": 24 } },
        { "kind": "@Collider", "name": "hitbox", "args": { "width": 144, "height": 24, "mode": "solid" } }
      ]
    },

    {
      "name": "p3",
      "depth": 0,
      "tags": ["platform"],
      "transform": { "position": { "x": 600, "y": 440 } },
      "components": [
        { "kind": "@Sprite", "name": "sprite", "args": { "texture": "platform.png", "width": 128, "height": 24 } },
        { "kind": "@Collider", "name": "hitbox", "args": { "width": 128, "height": 24, "mode": "solid" } }
      ]
    },

    {
      "name": "p4",
      "depth": 0,
      "tags": ["platform"],
      "transform": { "position": { "x": 60, "y": 300 } },
      "components": [
        { "kind": "@Sprite", "name": "sprite", "args": { "texture": "platform.png", "width": 96, "height": 24 } },
        { "kind": "@Collider", "name": "hitbox", "args": { "width": 96, "height": 24, "mode": "solid" } }
      ]
    },

    { "file": "objects/crate.obj", "transform": { "position": { "x": 260, "y": 512 } } },
    { "file": "objects/crate.obj", "transform": { "position": { "x": 470, "y": 512 } } },
    { "file": "objects/crate.obj", "transform": { "position": { "x": 430, "y": 336 } } },

    { "file": "objects/gold.obj", "transform": { "position": { "x": 200, "y": 412 } } },
    { "file": "objects/gold.obj", "transform": { "position": { "x": 270, "y": 412 } } },

    {
      "name": "door",
      "depth": 0,
      "tags": ["door"],
      "transform": { "position": { "x": 724, "y": 488 } },
      "components": [
        { "kind": "@Sprite", "name": "sprite", "args": { "texture": "door.png", "width": 32, "height": 48 } },
        {
          "kind": "@Animator",
          "name": "animator",
          "args": {
            "default": "closed",
            "clips": [
              { "name": "closed", "fps": 1, "loop": false, "frames": [
                { "position": { "x": 0, "y": 0 }, "size": { "x": 32, "y": 48 } }
              ] },
              { "name": "open", "fps": 1, "loop": false, "frames": [
                { "position": { "x": 32, "y": 0 }, "size": { "x": 32, "y": 48 } }
              ] }
            ]
          }
        },
        { "kind": "@Sound", "name": "sound", "args": { "sound": "door.wav" } },
        { "kind": "@Collider", "name": "hitbox", "args": { "width": 32, "height": 48, "mode": "trigger", "collidesWith": ["player"] } },
        { "kind": "components/door.go", "name": "door", "args": { "openDistance": 40, "warnDistance": 100 } }
      ]
    },

    {
      "name": "spikes",
      "depth": 0,
      "tags": ["hazard"],
      "transform": { "position": { "x": 360, "y": 528 } },
      "components": [
        { "kind": "@Sprite", "name": "sprite", "args": { "texture": "spike.png", "width": 24, "height": 8, "tint": { "r": 230, "g": 70, "b": 70, "a": 255 } } },
        { "kind": "@Collider", "name": "hitbox", "args": { "width": 24, "height": 8, "mode": "trigger", "collidesWith": ["player"] } },
        { "kind": "@Damage", "name": "damage", "args": { "amount": 1, "targetTags": ["player"], "cooldown": 1 } }
      ]
    },

    {
      "name": "walker",
      "depth": 1,
      "tags": ["enemy"],
      "transform": { "position": { "x": 620, "y": 416 } },
      "components": [
        { "kind": "@Collider", "name": "hitbox", "args": { "width": 24, "height": 24, "mode": "solid", "collidesWith": ["player", "platform", "wall"] } },
        { "kind": "@Mover", "name": "mover", "args": {} },
        { "kind": "@Velocity", "name": "velocity", "args": {} },
        { "kind": "@Gravity", "name": "gravity", "args": { "acceleration": { "x": 0, "y": 980 }, "maxSpeed": 700 } },
        { "kind": "@Patrol", "name": "patrol", "args": { "speed": 50, "points": [ { "x": 620, "y": 416 }, { "x": 700, "y": 416 } ] } },
        { "kind": "@Spin", "name": "spin", "args": { "speed": 4 } },
        { "kind": "@Sprite", "name": "sprite", "args": { "texture": "enemy.png", "width": 24, "height": 24, "tint": { "r": 255, "g": 150, "b": 50, "a": 255 } } }
      ]
    },

    {
      "name": "bat",
      "depth": 1,
      "tags": ["enemy"],
      "transform": { "position": { "x": 500, "y": 150 } },
      "components": [
        { "kind": "@Sprite", "name": "sprite", "args": { "texture": "enemy.png", "width": 20, "height": 20, "tint": { "r": 180, "g": 90, "b": 255, "a": 255 } } },
        { "kind": "@Spin", "name": "spin", "args": { "speed": 6 } },
        { "kind": "@Mover", "name": "mover", "args": {} },
        { "kind": "@Chase", "name": "chase", "args": { "speed": 90, "targetTag": "player", "stopDistance": 40 } }
      ]
    },

    {
      "name": "firefly",
      "depth": 1,
      "tags": ["firefly"],
      "transform": { "position": { "x": 600, "y": 100 } },
      "components": [
        { "kind": "@Sprite", "name": "sprite", "args": { "texture": "orb.png", "width": 12, "height": 12, "tint": { "r": 255, "g": 230, "b": 90, "a": 255 } } },
        { "kind": "@Spin", "name": "spin", "args": { "speed": 8 } },
        { "kind": "@Wander", "name": "wander", "args": { "speed": 40, "changeInterval": 1.5 } }
      ]
    },

    {
      "name": "ball",
      "depth": 1,
      "tags": ["ball"],
      "transform": { "position": { "x": 300, "y": 100 } },
      "components": [
        { "kind": "@Sprite", "name": "sprite", "args": { "texture": "orb.png", "width": 20, "height": 20, "tint": { "r": 255, "g": 90, "b": 90, "a": 255 } } },
        { "kind": "@Collider", "name": "hitbox", "args": { "width": 20, "height": 20, "mode": "solid", "collidesWith": ["platform", "wall"] } },
        { "kind": "@Mover", "name": "mover", "args": {} },
        { "kind": "@Bounce", "name": "bounce", "args": { "vx": 140, "vy": 90 } }
      ]
    },

    {
      "name": "pet",
      "depth": 1,
      "tags": ["pet"],
      "transform": { "position": { "x": 80, "y": 500 } },
      "components": [
        { "kind": "@Sprite", "name": "sprite", "args": { "texture": "orb.png", "width": 16, "height": 16, "tint": { "r": 90, "g": 220, "b": 255, "a": 255 } } },
        { "kind": "@Spin", "name": "spin", "args": { "speed": 3 } },
        { "kind": "@Follow", "name": "follow", "args": { "targetTag": "player", "lerp": 0.15, "offset": { "x": 30, "y": 30 } } }
      ]
    },

    {
      "name": "player",
      "depth": 10,
      "tags": ["player"],
      "transform": { "position": { "x": 120, "y": 470 } },
      "components": [
        { "kind": "@Collider", "name": "body", "args": { "width": 28, "height": 32, "mode": "solid", "collidesWith": ["platform", "wall", "crate", "enemy"] } },
        { "kind": "@Mover", "name": "mover", "args": {} },
        { "kind": "@Gravity", "name": "gravity", "args": { "acceleration": { "x": 0, "y": 980 }, "maxSpeed": 700 } },
        { "kind": "@Friction", "name": "friction", "args": { "amount": 900, "axes": "x" } },
        { "kind": "components/player.go", "name": "player", "args": { "speed": 180, "jumpSpeed": 520 } },
        { "kind": "@Velocity", "name": "velocity", "args": {} },
        { "kind": "@Health", "name": "health", "args": { "max": 3 } },
        { "kind": "@Sprite", "name": "sprite", "args": { "texture": "player.png", "width": 32, "height": 32 } },
        {
          "kind": "@Animator",
          "name": "animator",
          "args": {
            "default": "idle",
            "clips": [
              { "name": "idle", "fps": 2, "loop": true, "frames": [
                { "position": { "x": 0, "y": 0 }, "size": { "x": 16, "y": 16 } },
                { "position": { "x": 16, "y": 0 }, "size": { "x": 16, "y": 16 } }
              ] },
              { "name": "run", "fps": 10, "loop": true, "frames": [
                { "position": { "x": 32, "y": 0 }, "size": { "x": 16, "y": 16 } },
                { "position": { "x": 48, "y": 0 }, "size": { "x": 16, "y": 16 } },
                { "position": { "x": 64, "y": 0 }, "size": { "x": 16, "y": 16 } },
                { "position": { "x": 80, "y": 0 }, "size": { "x": 16, "y": 16 } }
              ] },
              { "name": "jump", "fps": 10, "loop": false, "frames": [
                { "position": { "x": 96, "y": 0 }, "size": { "x": 16, "y": 16 } }
              ] }
            ]
          }
        }
      ]
    }
  ]
}
